# Copy this file to .env and fill in values.
# .env is gitignored — your secrets never go to GitHub.

# ─── Required ─────────────────────────────────────────────────────────

# From @BotFather → /token → <pick your bot>
BOT_TOKEN=1234567890:AAAA-replace-me-with-token-from-BotFather

# Cloudflare Tunnel token. See bot/README.md "Cloudflare Tunnel setup"
# for the one-time provisioning steps. Without this, the sync API
# (Mini App → bot) won't be reachable from Telegram clients.
TUNNEL_TOKEN=eyJ...replace...with-tunnel-token-from-CF-dashboard

# ─── Optional ─────────────────────────────────────────────────────────

# URL of the Mini App. Default = GitHub Pages of this repo.
MINI_APP_URL=https://rossanoua.github.io/fasting-app/

# Port for the internal sync API (mapped to localhost only by compose).
# Cloudflare Tunnel forwards from public HTTPS to this port via the
# docker network — you don't need to expose it publicly.
SYNC_API_PORT=8080
SYNC_API_HOST=0.0.0.0
