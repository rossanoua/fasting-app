# Copy this file to .env and fill in your bot token from @BotFather.
# .env is gitignored — your token never goes to GitHub.

BOT_TOKEN=1234567890:AAAA-replace-me-with-token-from-BotFather

# Optional — defaults to the GitHub Pages URL.
# Used in /start message and "Open tracker" inline button.
MINI_APP_URL=https://rossanoua.github.io/fasting-app/
